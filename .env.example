# Application Settings
APP_NAME=Skill Extraction API
APP_VERSION=0.1.0
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO

# SpaCy Model
SPACY_MODEL=en_core_web_lg

# API Configuration
API_V1_PREFIX=/api/v1

# CORS Settings (comma-separated list)
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Maximum resume length (characters)
MAX_RESUME_LENGTH=50000
